# Copy to .env (git ignores it) and fill in. scripts/try-bank.sh reads
# these lines; .env is never sourced or committed.

# Product registration number (Deutsche Kreditwirtschaft). Required for every
# run against a bank. Never commit it; fints-client stars it in logs and traces.
FINTS_PRODUCT_ID=

# Optional: 64 hex digits that key the reference pseudonyms of traces, so
# traces recorded on different days can be compared (pending vs. booked,
# end-to-end IDs). Create with: openssl rand -hex 32
# Leave empty for a fresh salt per trace. Account identifiers get aliases of
# each trace either way, so a leaked salt reveals no account number.
FINTS_TRACE_SALT=
